generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                   String        @id @default(uuid())
  name                 String
  plan                 String        @default("lite")
  metaWhatsappEnabled    Boolean       @default(false) @map("meta_whatsapp_enabled")
  whatsappProvider       String        @default("meta") @map("whatsapp_provider")
  metaPhoneNumberId      String?       @map("meta_phone_number_id")
  metaWabaId             String?       @map("meta_waba_id")
  metaAccessToken        String?       @map("meta_access_token")
  metaWebhookVerifyToken String?       @map("meta_webhook_verify_token")
  msg91AuthKey           String?       @map("msg91_auth_key")
  msg91IntegratedNumber  String?       @map("msg91_integrated_number")
  // Email / SMTP config
  smtpHost               String?       @map("smtp_host")
  smtpPort               Int?          @map("smtp_port")
  smtpUser               String?       @map("smtp_user")
  smtpPass               String?       @map("smtp_pass")
  smtpFromEmail          String?       @map("smtp_from_email")
  smtpFromName           String?       @map("smtp_from_name")
  licenseKey             String?       @unique @map("license_key")
  status               String        @default("active")
  createdAt            DateTime      @default(now()) @map("created_at")

  users           User[]
  contacts        Contact[]
  contactNotes    ContactNote[]
  campaigns       Campaign[]
  emailCampaigns  EmailCampaign[]
  messageLogs     MessageLog[]
  emailLogs       EmailLog[]
  licenseKeys     LicenseKey[]
  inboundMessages InboundMessage[]
  auditLogs       AuditLog[]

  @@map("workspaces")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("marketer")
  permissions  Json?
  superAdmin   Boolean   @default(false) @map("super_admin")
  workspaceId  String    @map("workspace_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs  AuditLog[]

  @@index([workspaceId])
  @@map("users")
}

model LicenseKey {
  id          String    @id @default(uuid())
  key         String    @unique
  workspaceId String?   @map("workspace_id")
  plan        String    @default("lite")
  status      String    @default("inactive")
  expiryDate  DateTime? @map("expiry_date")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("license_keys")
}

model Contact {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  phone       String
  email       String?
  tags        String[]
  optIn       Boolean  @default(false) @map("opt_in")
  leadStatus  String   @default("new") @map("lead_status")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageLogs     MessageLog[]
  emailLogs       EmailLog[]
  inboundMessages InboundMessage[]
  notes           ContactNote[]

  @@index([workspaceId])
  @@index([phone])
  @@map("contacts")
}

model ContactNote {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  contactId   String   @map("contact_id")
  userId      String?  @map("user_id")
  userEmail   String?  @map("user_email")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("contact_notes")
}

model Campaign {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  name        String
  template    String
  status      String    @default("draft")
  scheduledAt DateTime? @map("scheduled_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageLogs MessageLog[]

  @@index([workspaceId])
  @@map("campaigns")
}

model EmailCampaign {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  name        String
  subject     String
  body        String
  status      String    @default("draft")
  scheduledAt DateTime? @map("scheduled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs      EmailLog[]

  @@index([workspaceId])
  @@map("email_campaigns")
}

model MessageLog {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  contactId   String   @map("contact_id")
  campaignId  String?  @map("campaign_id")
  status      String   @default("sent")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("message_logs")
}

model EmailLog {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  campaignId  String?  @map("campaign_id")
  contactId   String   @map("contact_id")
  toEmail     String   @map("to_email")
  status      String   @default("sent")
  sentAt      DateTime @default(now()) @map("sent_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact   Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("email_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String?  @map("user_id")
  userEmail   String?  @map("user_email")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model InboundMessage {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  contactId       String?  @map("contact_id")
  fromPhone       String   @map("from_phone")
  messageId       String   @unique @map("message_id")
  type            String   @default("text")
  body            String?
  replyToMessageId String? @map("reply_to_message_id")
  rawPayload      Json     @map("raw_payload")
  read            Boolean  @default(false)
  receivedAt      DateTime @default(now()) @map("received_at")

  campaignId       String?  @map("campaign_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([fromPhone])
  @@index([campaignId])
  @@map("inbound_messages")
}
