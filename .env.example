# ══════════════════════════════════════════════════════════════════════════════
#  WhatsApp SaaS Lite — Runtime Configuration
#  Copy this file to .env and fill in your values.
#  All settings here drive the Docker container at runtime — no rebuild needed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Public URL ────────────────────────────────────────────────────────────────
# The address users open in their browser.
# Used in password reset links and the MSG91 webhook callback URL.
# Examples:
#   http://103.118.158.189:3000
#   https://wa.yourcompany.com
APP_URL=http://YOUR_SERVER_IP:3000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# ── Database (if using the bundled postgres from docker-compose) ──────────────
POSTGRES_DB=whatsappsaas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# If you have an EXTERNAL database, set DATABASE_URL directly instead:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Exposed port ──────────────────────────────────────────────────────────────
# The host port the app listens on (maps to container port 3000)
PORT=3000

# ── Branding (optional) ───────────────────────────────────────────────────────
APP_NAME=WA SaaS Lite
CONTACT_EMAIL=hello@example.com

# ── First-run admin account ───────────────────────────────────────────────────
# Only used on first deploy when no admin exists. Change after first login.
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=admin123
SEED_WORKSPACE_NAME=Demo Workspace

# ── Meta Cloud API (optional — only needed if using Meta provider) ────────────
META_APP_SECRET=
META_GRAPH_VERSION=v19.0
