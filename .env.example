# ══════════════════════════════════════════════════════════════════════════════
#  WhatsApp SaaS Lite — Runtime Configuration
#  Copy to .env, fill in your values, then: docker compose up -d --build
#  Change any value here and restart — no rebuild needed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@204.168.165.148:5432/whatsappsaa

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# ── Public URL ────────────────────────────────────────────────────────────────
# The address users open in their browser.
# Used in password reset links and shown as the MSG91 webhook callback URL.
APP_URL=http://103.118.158.189:3000

# ── Exposed port ──────────────────────────────────────────────────────────────
PORT=3000

# ── First-run admin account ───────────────────────────────────────────────────
# Only used on first deploy when no admin exists. Change password after login.
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=admin123
SEED_WORKSPACE_NAME=Demo Workspace

# ── Optional ──────────────────────────────────────────────────────────────────
META_APP_SECRET=
META_GRAPH_VERSION=v19.0
APP_NAME=WA SaaS Lite
CONTACT_EMAIL=hello@example.com
