# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/whatsapp_saas"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Encryption key for provider credentials at rest (Meta/MSG91 keys, SMTP password).
# Any-length secret — it's hashed to a 256-bit key. Use a long random string.
# If unset, falls back to JWT_SECRET (set a dedicated key in production).
# WARNING: rotating this key makes existing encrypted credentials undecryptable
# (they'll need to be re-entered in Settings).
ENCRYPTION_KEY="change-me-to-a-long-random-string-in-production"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Meta webhook signature verification (optional but strongly recommended in production)
# Set to your Meta App Secret from https://developers.facebook.com/apps
META_APP_SECRET=

# MSG91 webhook shared secret (strongly recommended in production).
# MSG91 does not sign webhooks, so set this and append ?token=<value> to the
# webhook URL configured in the MSG91 dashboard (or send it as x-webhook-token).
# If unset, the MSG91 webhook accepts unauthenticated (forgeable) events.
MSG91_WEBHOOK_TOKEN=

# MSG91 template API host override (optional)
# Default: control.msg91.com (the canonical MSG91 host — confirmed live).
# Only set this if you need to point to a custom/proxy endpoint.
# MSG91_TEMPLATE_HOST=control.msg91.com

# ── File Uploads ──────────────────────────────────────────────
# Public base URL for this backend — used to build URLs for uploaded files that
# are sent to Meta/MSG91 as template header media samples. Meta/MSG91 servers
# must be able to fetch this URL during template review, so in production this
# must be a publicly reachable HTTPS domain.
BACKEND_PUBLIC_URL=http://localhost:4000
# Set to your frontend domain to serve uploads via /uploads/[filename] (cleaner URL
# that WhatsApp/MSG91 can reliably fetch). e.g. https://yourdomain.com
MEDIA_PUBLIC_URL=

# Filesystem path for uploaded template-media files.
# Defaults to ./uploads relative to the backend process working directory.
# In Docker/production, mount a persistent volume and set this accordingly.
# UPLOAD_DIR=/data/uploads
