# Internal backend URL used by Next.js server to proxy /api/* requests.
# Use IP:PORT — never exposed to the browser.
# Same machine (default):  http://127.0.0.1:4000
# Docker Compose service:  http://backend:4000
BACKEND_URL=http://127.0.0.1:4000

# Public-facing URL of this app — shown in the guide page for webhook setup.
# Set to your domain or IP:PORT.
NEXT_PUBLIC_APP_URL=http://localhost:3000
